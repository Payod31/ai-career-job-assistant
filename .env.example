# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — it is the only place your real key lives.
# NEVER commit, log, or paste your real key into source code.

# ---- Provider selection ----------------------------------------------------
# Which AI provider the /api endpoints use: 'openai', 'gemini', or 'auto'.
#   auto   = OpenAI if OPENAI_API_KEY is set, otherwise Gemini (if GEMINI_API_KEY is set)
#   gemini = always use Gemini (recommended for the free Render deployment)
#   openai = always use OpenAI
# A Gemini failure NEVER silently falls back to OpenAI.
AI_PROVIDER=auto

# ---- OpenAI (optional if using Gemini) -------------------------------------
# Your OpenAI API key (create one at https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# Model used for the AI endpoints. Default is gpt-5.5.
# If your account does not support that model, change it to one you have access to
# (for example: gpt-4o, gpt-4.1, o3, or another model id) and restart the server.
OPENAI_MODEL=gpt-5.5

# ---- Gemini / Google AI Studio (free tier; recommended for Render) ---------
# Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Free-tier Gemini model. Default is gemini-2.5-flash. Change to another model
# you have access to (for example: gemini-2.5-flash-lite, gemini-2.0-flash, or
# gemini-flash-latest) and restart.
GEMINI_MODEL=gemini-2.5-flash

# ---- Local server ----------------------------------------------------------
# Optional: port the local server binds to. Defaults to 8000. Binds to 127.0.0.1 only.
# On Render, the PORT is supplied by the platform — do not hard-code it there.
PORT=8000

# ---- Rate limiting (AI routes only) ----------------------------------------
# Per-client limit for /api/analyze-resume and /api/resume-studio.
# Defaults to 30/minute when unset. Tune lower for a public Render URL.
AI_RATE_LIMIT=30/minute

# Optional shared storage for the limits (in-memory is the default, which is
# correct for a single-instance deployment). PostgreSQL example:
# RATELIMIT_STORAGE_URI=postgresql://user:pass@host/db
#
# If you run behind a trusted edge proxy and want per-client (not
# per-connection) limits, set the proxy IPs here (comma-separated).
# Without it, client-supplied X-Forwarded-For headers are never trusted.
# TRUSTED_PROXIES=
